{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TypeScript Compiler Configuration Schema",
  "type": "object",
  "properties": {
    "compilerOptions": {
      "type": "object"
    },
    "include": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "references": {
      "type": "array"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

