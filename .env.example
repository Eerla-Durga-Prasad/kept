# -------------------------------------------------------------------
# Kept — Environment Variables
# Copy this file to .env and fill in your Supabase project credentials.
# Without these values the app runs in High-Fidelity Local Simulation
# Mode — the full offline-first path (Dexie.js outbox + BroadcastChannel)
# is exercised without a live cloud backend.
# -------------------------------------------------------------------

# Supabase project URL  (e.g. https://xyzabc123.supabase.co)
VITE_SUPABASE_URL=https://mdwoqftnmzhwlamcecqb.supabase.co

# Supabase anonymous / public key (safe to expose in browser bundles)
VITE_SUPABASE_ANON_KEY=sb_publishable_qrICBkjl0QiSlEbzkZJjEw_oFU2vjon

# Public Canonical Application URL (e.g. https://kept-seven-drab.vercel.app/)
# Used to generate invitation links. If omitted, falls back to window.location.origin.
VITE_APP_URL=https://kept-seven-drab.vercel.app/

