# -------------------------------------------------------------------
# Kept — Environment Variables
# Copy this file to .env and fill in your Supabase project credentials.
# Without these values the app runs in High-Fidelity Local Simulation
# Mode — the full offline-first path (Dexie.js outbox + BroadcastChannel)
# is exercised without a live cloud backend.
# -------------------------------------------------------------------

# Supabase project URL  (e.g. https://xyzabc123.supabase.co)
VITE_SUPABASE_URL=

# Supabase anonymous / public key (safe to expose in browser bundles)
VITE_SUPABASE_ANON_KEY=
